# OCI Bastion Configuration
OCI_BASTION_SESSION_ID=ocid1.bastionsession.oc1.ap-tokyo-1.xxxxx
OCI_BASTION_HOST=host.bastion.ap-tokyo-1.oci.oraclecloud.com
OCI_BASTION_USERNAME=ocid1.bastionsession.oc1.ap-tokyo-1.xxxxx

# HeatWave MySQL Configuration
MYSQL_HOST=10.0.x.x
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=your_secure_password
MYSQL_DATABASE=tatebayashi_stones

# SSH Key Configuration
SSH_PRIVATE_KEY_PATH=~/.ssh/oci_bastion_key

# OCI Configuration (for API access if needed)
OCI_TENANCY_OCID=ocid1.tenancy.oc1..xxxxx
OCI_USER_OCID=ocid1.user.oc1..xxxxx
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_REGION=ap-tokyo-1
OCI_KEY_FILE=~/.oci/oci_api_key.pem

# Bastion Tunnel Configuration
LOCAL_MYSQL_PORT=3307