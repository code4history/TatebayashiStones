{
  "name": "tatebayashi-stones-oci",
  "version": "1.0.0",
  "description": "OCI Bastion and HeatWave MySQL integration for TatebayashiStones",
  "scripts": {
    "test-connection": "node scripts/test-connection.js",
    "init-db": "node migrations/init-database.js",
    "migrate-data": "node migrations/geojson-to-mysql.js",
