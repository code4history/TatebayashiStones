    "create-session": "node scripts/create-bastion-session.js",
    "setup": "npm run create-session && npm run connect"
  },
  "dependencies": {
    "mysql2": "^3.6.0",
    "dotenv": "^16.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  }
}