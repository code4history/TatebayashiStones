# Cloudflare Account ID
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Cloudflare Images Configuration
# Account Hash - used in the delivery URL
CLOUDFLARE_IMAGES_ACCOUNT_HASH=your_account_hash_here
# Images API Token - for uploading images
CLOUDFLARE_IMAGES_API_TOKEN=your_images_api_token_here

# Project Configuration
PROJECT_PREFIX=tatebayashi_stones

# Authentication Token for upload endpoint
AUTH_TOKEN=your_secure_token_here

# CORS Configuration
CORS_ORIGIN=*

# Optional: Custom domain settings for Images
# CUSTOM_IMAGES_DOMAIN=code4history.dev
# CUSTOM_IMAGES_PATH=/images