# Cloudflare Account ID
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# R2 Bucket Configuration
R2_BUCKET_NAME=tatebayashi-stones-images
# R2 Public URL (例: https://61f248de47f07bdbf3dd2133a5378e64.r2.cloudflarestorage.com)
R2_PUBLIC_URL=https://your-account-hash.r2.cloudflarestorage.com

# Authentication Token
AUTH_TOKEN=your_secure_token_here

# CORS Configuration
CORS_ORIGIN=*

# Custom domain settings
ZONE_ID=your_zone_id_here
CUSTOM_DOMAIN=r2.code4history.dev